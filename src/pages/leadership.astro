  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      initTabs();
    });
    document.addEventListener("astro:after-swap", () => {
      initTabs();
    });

    function initTabs() {
      document.querySelectorAll(".tabs-wrapper").forEach((wrapper) => {
        const buttons = wrapper.querySelectorAll(".tab-btn");
        const panels = wrapper.querySelectorAll(".tab-panel");

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const targetId = btn.getAttribute("data-target");

            buttons.forEach((b) => {
              b.classList.remove("active", "bg-primary", "text-primary-foreground", "font-medium");
              b.classList.add("bg-muted", "text-muted-foreground");
              b.setAttribute("aria-selected", "false");
            });

            btn.classList.add("active", "bg-primary", "text-primary-foreground", "font-medium");
            btn.classList.remove("bg-muted", "text-muted-foreground");
            btn.setAttribute("aria-selected", "true");

            panels.forEach((p) => {
              if (p.id === targetId) {
                p.classList.remove("hidden");
              } else {
                p.classList.add("hidden");
              }
            });
          });
        });
      });
    }
  </script>
